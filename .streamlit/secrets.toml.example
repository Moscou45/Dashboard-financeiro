# Copie para secrets.toml somente na sua máquina; não envie o arquivo com credenciais ao Git.
APP_ENV = "production"

[database]
url = "postgresql://postgres:SUA_SENHA@HOST_DO_POOLER:5432/postgres?sslmode=require"

[auth]
redirect_uri = "https://SEU_DOMINIO/oauth2callback"
cookie_secret = "GERE_UM_VALOR_ALEATORIO_LONGO"
client_id = "CLIENT_ID_DO_GOOGLE"
client_secret = "CLIENT_SECRET_DO_GOOGLE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[authorization]
owner_email = "SEU_EMAIL"
viewer_email = "EMAIL_DO_PATRÃO"
